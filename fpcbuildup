#!/usr/bin/env bash
set -e

FIXES=$(git branch -a | grep -o 'fixes_[0-9]*_[0-9]*' | sort -V | tail -1)
if [ -z "$FIXES" ]; then
    echo "Error: no fixes branch found" >&2
    exit 1
fi
echo "Using $FIXES for fixes"

for branch in main "$FIXES"; do
    git checkout "$branch"
    git pull
    git -C fpcsrc checkout "$branch"
    git -C fpcsrc pull
    git -C fpcdocs checkout main
    git -C fpcdocs pull
    git add -A
    git diff --cached --quiet || git commit -m "* updated $branch"
    git push
done

git checkout main
git submodule update
